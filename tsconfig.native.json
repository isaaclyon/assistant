{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node",
      "vitest/globals"
    ],
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/durable/**/*.ts",
    "tests/durable/**/*.ts"
  ]
}
