{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node",
      "vitest/globals"
    ],
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/durable/**/*.ts",
    ".pi/extensions/subagents/inspection.ts",
    "tests/durable/**/*.ts",
    ".pi/lib/mutation-lock.mjs",
    ".pi/skills/personal-memory/scripts/*.mjs",
    "src/jobs-cli.ts",
    "src/price-watches.ts",
    "src/checkers/*.ts"
  ]
}
