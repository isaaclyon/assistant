{
  "name": "pi-telegram-bridge-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A durable, systemd-supervised Pi host for the pi-telegram extension",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run typecheck:extensions && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "deploy": "bash scripts/deploy.sh",
    "jobs:check": "node dist/src/jobs-check.js",
    "places": "node dist/src/places-cli.js",
    "service:install": "npm run build && node dist/src/install-service.js",
    "postinstall": "node scripts/patch-codex-conversion.mjs && node scripts/patch-telegram-tool-activity.mjs && node scripts/patch-telegram-new-session-dedup.mjs && node scripts/patch-telegram-agent-settled.mjs && node scripts/patch-telegram-subagent-target-scope.mjs",
    "start": "node dist/src/daemon.js",
    "telegram:setup": "npm run build && node dist/src/setup.js",
    "test": "vitest run --exclude '.worktrees/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:extensions": "tsc -p tsconfig.extensions.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@howaboua/pi-codex-conversion": "2.2.13",
    "@llblab/pi-telegram": "https://codeload.github.com/isaaclyon/pi-telegram/tar.gz/097ac628c84ba0652a2922d5489ef924107c7fbd",
    "@narumitw/pi-retry": "0.22.0",
    "croner": "^10.0.1",
    "marked": "18.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
