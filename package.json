{
  "name": "assistant-durable-c1-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prototype-only C1 evidence; not a deployable assistant release",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "check:changed": "npm run check",
    "typecheck": "tsc -p prototypes/durable-c1/tsconfig.json --noEmit",
    "build": "tsc -p prototypes/durable-c1/tsconfig.json",
    "test": "vitest run --config prototypes/durable-c1/vitest.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
