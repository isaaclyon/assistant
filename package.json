{
  "name": "pi-telegram-bridge-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A durable, systemd-supervised Pi host for the pi-telegram extension",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "service:install": "npm run build && node dist/src/install-service.js",
    "start": "node dist/src/daemon.js",
    "telegram:setup": "npm run build && node dist/src/setup.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@llblab/pi-telegram": "https://codeload.github.com/isaaclyon/pi-telegram/tar.gz/3f2ed12ebb8e9533f2c46b9b38a707e6ba1c8246"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
